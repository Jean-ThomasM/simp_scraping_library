# Fichier d'exemple .env - Copiez ce fichier en .env et ajustez les valeurs

# Configuration du Scraping
BASE_URL=https://books.toscrape.com
MAX_PAGES=50
# MODE: 'prod' pour tout scraper, 'test' pour le mode échantillon
MODE=test
SAMPLE_SIZE=20

# Configuration Réseau
USER_AGENT="Bouquineo_Bot/1.0 (+contact@bouquineo.fr)"
REQUEST_DELAY=1.5 # Délai en secondes entre chaque requête

# Configuration Base de Données PostgreSQL
POSTGRES_DB=bouquineo
POSTGRES_USER=myuser
POSTGRES_PASSWORD=mypassword
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
